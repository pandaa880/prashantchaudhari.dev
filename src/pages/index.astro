---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { getHomeSchema, getProfileImageURL } from "@/utils/structuredData";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";
import { Image } from "astro:assets";

import profilePicture from "../assets/images/profile-picture.jpg";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

const structuredData = getHomeSchema(await getProfileImageURL());

const PROJECT_LINKS = [
  { label: "Live demo", href: "https://tee-income-oracle-web.vercel.app" },
  {
    label: "Verify a receipt",
    href: "https://tee-income-oracle-web.vercel.app/verify",
  },
  { label: "Source", href: "https://github.com/pandaa880/tee-income-oracle" },
];
---

<Layout
  title={`${SITE.title} · Senior Frontend Engineer`}
  structuredData={structuredData}
>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section id="hero" class:list={["pt-8 pb-6", "border-b border-border"]}>
      <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:gap-8">
        <div class="shrink-0">
          {
            profilePicture ? (
              <Image
                src={profilePicture}
                alt="Illustrated portrait of Prashant with his dog in the mountains"
                class="h-[100px] w-[100px] rounded-full border border-border object-cover sm:h-[180px] sm:w-[180px]"
                width={180}
                height={180}
                widths={[100, 180, 200, 360]}
                sizes="(min-width: 640px) 180px, 100px"
                loading="eager"
              />
            ) : null
          }
        </div>
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-2">
            <h1
              class="my-2 text-3xl font-bold tracking-tight sm:my-4 sm:text-4xl"
            >
              Hi, I'm Prashant Chaudhari.
            </h1>
            <a
              target="_blank"
              href="/rss.xml"
              class="inline-block"
              aria-label="RSS feed"
              title="RSS Feed"
            >
              <IconRss
                width={20}
                height={20}
                class="scale-125 stroke-accent stroke-3 rtl:-rotate-90"
              />
              <span class="sr-only">RSS Feed</span>
            </a>
          </div>
          <p class="mt-3 text-foreground/90">
            I build fintech interfaces that show their work: four years on
            credit products at Deserve and Intuit, now verifiable credit on
            Solana.
          </p>
          <p class="mt-3 text-foreground/90">
            Open to remote senior frontend and full-stack roles with Solana and
            fintech teams. Based in Bangalore.
            <a
              href="https://x.com/pandaa880"
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent decoration-dashed underline-offset-4 hover:underline"
              >DM me on X</a
            >.
          </p>
          {
            SOCIALS.length > 0 && (
              <div class="mt-4 flex max-sm:flex-col sm:items-center">
                <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
                  Social Links:
                </div>
                <Socials />
              </div>
            )
          }
        </div>
      </div>
    </section>

    <section
      id="featured-project"
      class:list={[
        "pt-12 pb-6",
        {
          "border-b border-border":
            featuredPosts.length > 0 || recentPosts.length > 0,
        },
      ]}
    >
      <h2 class="text-2xl font-semibold tracking-wide">Featured project</h2>
      <div class="my-6">
        <h3 class="text-lg font-medium">TEE Income Oracle</h3>
        <p class="text-sm opacity-80">
          Colosseum World's Fair hackathon · built solo, 2026
        </p>
        <p class="mt-2">
          A per-loan receipt for credit funders. A borrower's bank statement, in
          India's Account Aggregator format (sandbox data in the demo), is
          checked inside an AWS Nitro enclave and never leaves it. Solana gets
          the tier, the policy hash and the statement's date range; a lending
          pool reads it inside its own instruction, and anyone can verify the
          receipt in their browser.
        </p>
        <p class="mt-2 text-sm opacity-80">
          19 days from first commit to the judged release · 1,100+ web tests ·
          live on devnet
        </p>
        <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1">
          {
            PROJECT_LINKS.map(({ label, href }) => (
              <li>
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-accent decoration-dashed underline-offset-4 hover:underline"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-b border-border": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">Featured</h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">Recent Posts</h2>
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        All Posts
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
