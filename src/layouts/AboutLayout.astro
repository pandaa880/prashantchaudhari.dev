---
import type { MarkdownLayoutProps } from "astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Layout from "./Layout.astro";
import { SITE } from "@/config";
import {
  getProfileImageURL,
  getProfilePageSchema,
} from "@/utils/structuredData";

type Props = MarkdownLayoutProps<{ title: string; description?: string }>;

const { frontmatter } = Astro.props;

const structuredData = getProfilePageSchema(
  new URL(Astro.url.pathname, Astro.site).href,
  await getProfileImageURL()
);
---

<Layout
  title={`${frontmatter.title} | ${SITE.title}`}
  description={frontmatter.description}
  structuredData={structuredData}
>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout">
    <section id="about" class="app-prose mb-28 max-w-app prose-img:border-0">
      <h1 class="text-2xl tracking-wider sm:text-3xl">{frontmatter.title}</h1>
      <slot />
    </section>
    <section
      id="github-activity"
      class="app-prose mb-28 max-w-app prose-img:border-0"
    >
      <h2 class="text-xl tracking-wider sm:text-2xl">GitHub Activity</h2>
      <p class="mb-4">
        <a
          href={`https://github.com/${SITE.githubUsername}`}
          target="_blank"
          rel="noopener noreferrer"
          class="underline hover:no-underline"
        >
          Follow me on GitHub
        </a>
      </p>
      <img
        src={`https://ghchart.rshah.org/${SITE.githubUsername}`}
        alt={`${SITE.githubUsername}'s GitHub contribution chart`}
        class="h-auto max-w-full"
        width="800"
        height="200"
        loading="lazy"
      />
    </section>
  </main>
  <Footer />
</Layout>
